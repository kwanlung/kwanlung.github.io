---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { slugifyAll } from "@/utils/slugify";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const targetLocale = locale === "en" ? "zh" : "en";

const path = stripLocale(
  stripBase(Astro.url.pathname).replace(/\/+$/, ""),
  locale
);

const posts = await getCollection("posts", postFilter);

const safeDecode = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

let href: string;

if (/^\/posts\/\d+$/.test(path)) {
  // Paginated listing: page numbers differ per language, link to page 1.
  href = getRelativeLocaleUrl(targetLocale, "posts");
} else if (path.startsWith("/posts/")) {
  const slug = path.slice("/posts".length);
  const current = posts.find(
    p => p.data.lang === locale && getPostSlug(p.id, p.filePath) === slug
  );
  const translation = current?.data.translationKey
    ? posts.find(
        p =>
          p.data.lang === targetLocale &&
          p.data.translationKey === current.data.translationKey
      )
    : undefined;
  href = translation
    ? getPostUrl(translation.id, translation.filePath, targetLocale)
    : getRelativeLocaleUrl(targetLocale, "posts");
} else if (path.startsWith("/tags/")) {
  const tag = safeDecode(path.slice("/tags/".length).split("/")[0]);
  const tagExists = posts.some(
    p => p.data.lang === targetLocale && slugifyAll(p.data.tags).includes(tag)
  );
  href = tagExists
    ? getRelativeLocaleUrl(targetLocale, `tags/${tag}`)
    : getRelativeLocaleUrl(targetLocale, "tags");
} else {
  href = getRelativeLocaleUrl(targetLocale, path === "/" ? "" : path.slice(1));
}
---

<li class="col-span-1 flex items-center justify-center">
  <a
    href={href}
    hreflang={targetLocale}
    class="focus-outline hover:text-accent flex size-8 items-center justify-center text-sm font-medium"
    title={t.a11y.switchLanguage}
    aria-label={t.a11y.switchLanguage}
  >
    {targetLocale === "zh" ? "中文" : "EN"}
  </a>
</li>